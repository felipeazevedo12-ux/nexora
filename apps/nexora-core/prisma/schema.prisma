generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
}

model channels {
id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
server_id  String     @db.Uuid
name       String     @db.VarChar(100)
type       String     @default("text") @db.VarChar(20)
created_at DateTime   @default(now()) @db.Timestamptz(6)

servers  servers   @relation(fields: [server_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "channels_server_id_servers_id_fk")
messages messages[]
}

model messages {
id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
channel_id String   @db.Uuid
author_id  String   @db.Uuid
content    String
created_at DateTime @default(now()) @db.Timestamptz(6)

users    users    @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_author_id_users_id_fk")
channels channels @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_channel_id_channels_id_fk")
}

model server_members {
user_id   String   @db.Uuid
server_id String   @db.Uuid
joined_at DateTime @default(now()) @db.Timestamptz(6)

servers servers @relation(fields: [server_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "server_members_server_id_servers_id_fk")
users   users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "server_members_user_id_users_id_fk")

@@id([user_id, server_id], map: "server_members_user_id_server_id_pk")
}

model servers {
id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
name           String           @db.VarChar(100)
icon           String?
owner_id       String           @db.Uuid
created_at     DateTime         @default(now()) @db.Timestamptz(6)

channels       channels[]
server_invites server_invites[]
server_members server_members[]

users users @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "servers_owner_id_users_id_fk")
}

model server_invites {
id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
code       String    @unique @db.VarChar(32)
server_id  String   @db.Uuid
creator_id String   @db.Uuid
created_at DateTime  @default(now()) @db.Timestamptz(6)
expires_at DateTime? @db.Timestamptz(6)

users   users   @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
servers servers @relation(fields: [server_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

@@index([server_id])
@@index([creator_id])
}

model users {
id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
username      String   @unique(map: "users_username_unique") @db.VarChar(32)
email         String   @unique(map: "users_email_unique") @db.VarChar(255)
password_hash String
avatar        String?
nickname      String?  @db.VarChar(32)
bio           String?
banner        String?
created_at    DateTime @default(now()) @db.Timestamptz(6)
updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

messages       messages[]
server_invites server_invites[]
server_members server_members[]
servers        servers[]
}

